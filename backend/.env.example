PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/qa_platform?retryWrites=true&w=majority
JWT_SECRET=your_64_char_random_secret_here
CLIENT_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# SMTP (required for OTP login)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@athivatech.com
SMTP_PASS=your_app_password
SMTP_FROM="Q&A Platform <noreply@athivatech.com>"
