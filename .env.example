# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── JWT (keep same value as the previous JWT_SECRET on Railway) ────────────────
JWT_SECRET=your-64-char-hex-secret

# ── Zoho SMTP (unchanged from Railway) ────────────────────────────────────────
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@athivatech.com
SMTP_PASS=your-zoho-app-password
SMTP_FROM="Q&A Platform <your@athivatech.com>"

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
CLIENT_URL=https://your-project.vercel.app

# ── Frontend (Vite) — add to frontend/.env ────────────────────────────────────
# VITE_API_URL is /api by default (same-domain Vercel deployment).
# Only set this if the API is deployed on a different domain.
# VITE_API_URL=https://your-api-domain.vercel.app/api

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
